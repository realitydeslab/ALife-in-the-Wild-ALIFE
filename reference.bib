@misc{Ante2025Transforming,
  type = {{{SSRN Scholarly Paper}}},
  title = {Transforming {{Entrepreneurship}} through {{Autonomous AI Agents}}: {{A Case Study}} of the {{Terminal}} of {{Truths}}},
  shorttitle = {Transforming {{Entrepreneurship}} through {{Autonomous AI Agents}}},
  author = {Ante, Lennart},
  year = {2025},
  month = jan,
  number = {5083067},
  eprint = {5083067},
  publisher = {Social Science Research Network},
  address = {Rochester, NY},
  doi = {10.2139/ssrn.5083067},
  url = {https://doi.org/10.2139/ssrn.5083067},
  abstract = {This study examines how autonomous AI agents-autonomous software entities capable of adapting, learning, and performing multi-step operations-shape entrepreneurial processes while also illustrating how the seemingly funny and wild examples of meme culture serve as an early glimpse into the technology's far-reaching potential. Focusing on the autonomous AI agent Terminal of Truths (ToT) and its involvement in the ideation, creation, and financial performance of crypto-based meme ventures such as Fartcoin and Goatseus Maximus, we reveal that ToT's predictive analytics, adaptive insights, and data-driven endorsements influenced strategic decision-making, reinforced organizational legitimacy, and mitigated information asymmetry. These playful meme ventures underscore the ability of autonomous AI agents to catalyze future innovations: ToT functioned as an intangible, hard-to-imitate resource that facilitated creativity, improved operational efficiency, and bolstered competitive advantages. By generating credible, evidence-based recommendations, ToT cultivated stakeholder trust, satisfied institutional expectations, and nurtured more stable investor relations. Moreover, ToT's continuous intelligence reduced uncertainty, enabling ventures to align with evolving market conditions. This study proposes a conceptual framework wherein autonomous AI agents enhance entrepreneurial efficiency by refining strategic capabilities, legitimacy, and datadriven responsiveness. Future inquiries may explore how such agents adapt across diverse contexts, offering new perspectives on entrepreneurial resilience and performance in digital ecosystems.},
  archiveprefix = {Social Science Research Network},
  langid = {english},
  keywords = {AI Agents,Artificial Intelligence,Cryptocurrency,Entrepreneurial Finance,New Venture Ideation,New Venture Performance},
  file = {/Users/amber/Zotero/storage/2QIYY2EB/Ante - 2025 - Transforming Entrepreneurship through Autonomous AI Agents A Case Study of the Terminal of Truths.pdf}
}
